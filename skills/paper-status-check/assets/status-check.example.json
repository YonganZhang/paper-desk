{
  "_comment": "复制到 ~/.config/paper-desk/status-check.json（或用环境变量 PAPER_STATUS_CONFIG 指定路径）。字段说明见 references/config.md。",
  "ledger_cli": "paper",
  "self_names": ["张三", "San Zhang"],
  "always_scan": ["alice@example.com"],
  "blocking_confirm_journals": ["Example Journal A"],
  "near_acceptance_stages": ["小修", "已录用"],
  "extra_manuscript_id_patterns": ["XYZ-\\d{4}-\\d{4}", "[A-Z]{5}\\d{5}"],
  "work_dir": "~/.cache/paper-status-check",
  "report": {
    "from": "alice@example.com",
    "to": ["alice@example.com"],
    "subject": "【张三】投稿与期刊情况追踪（{date}）",
    "greeting": "张三您好：",
    "sender_label": "投稿服务器",
    "schedule_label": "每周一 10:00",
    "timezone": "Asia/Shanghai",
    "out_dir": "~/.local/share/paper-desk/weekly-status"
  },
  "people": {
    "张三": {"email": "alice@example.com", "role": "owner"},
    "李四": {"email": "lisi@example.com", "role": "student", "cc_owner": true},
    "王五": {"email": "wangwu@example.org", "role": "external"}
  },
  "reminders": {
    "modes": ["student", "watch", "ai"],
    "due_days": 14,
    "stalled_days": 60,
    "blocked_stages": ["awaiting_author", "waiting_support", "awaiting_close"],
    "min_interval_days": 7,
    "include_external": false,
    "owner": "张三",
    "from": "alice@example.com",
    "subject": "论文跟进提醒（{date}）：{count} 项",
    "greeting": "{name}您好：",
    "signature": "——\n本邮件由{sender_label}自动发送，只提醒组内跟进人，不会替您联系期刊或编辑部。"
  }
}
