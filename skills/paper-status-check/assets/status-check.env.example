# paper-status-check 定时任务的环境变量示例。复制到 ~/.config/paper-desk/status-check.env，chmod 600。
# systemd 单元用 EnvironmentFile 读它；手动运行时 set -a; . ~/.config/paper-desk/status-check.env; set +a

# 配置文件位置（不设就用默认值）。systemd 不展开 $HOME，写绝对路径
# PAPER_STATUS_CONFIG=/home/alice/.config/paper-desk/status-check.json
# PAPER_MAILBOXES=/home/alice/.config/paper-desk/mailboxes.json

# 邮箱配置里 password_env 指向的变量
MAIL_ALICE_PASSWORD=change-me

# 浏览器（与 paper-submit 共用，见 paper-submit/references/setup.md）
PAPER_SUBMIT_HOME=/home/alice/.local/share/paper-submit
PAPER_SUBMIT_PASSWORD_CMD=pass show paper-submit/default
PAPER_SUBMIT_DISPLAY=:97
# HTTPS_PROXY=http://127.0.0.1:7890

# 台账 CLI（不在 PATH 上时写全路径）
# PAPER_CLI=/home/alice/bin/paper
